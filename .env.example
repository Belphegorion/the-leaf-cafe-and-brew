# ==============================================================================
# The Leaf – Cafe and Brew: Environment Configuration Template
# Pure-Vegetarian Artisanal Cafe & Brew Bar · E-8, Arera Colony, Bhopal, MP
# ==============================================================================

# Server Network & Runtime
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Staff Authentication & Token Secrets (HMAC-SHA256)
# Minimum 16 characters required. Generate using: openssl rand -base64 32
JWT_SECRET=leaf_jwt_secret_dev_key_2026_sanctuary
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=leaf_refresh_secret_dev_key_2026_sanctuary
REFRESH_TOKEN_EXPIRES_IN=7d

# Razorpay Payment Gateway & Webhook Signature
# Placeholders for development; configure live test credentials before launch
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_placeholder_secret

# Optional Database & Cache Escalation (Defaults to In-Memory Engine)
# MONGODB_URI=mongodb://localhost:27017/theleaf
# REDIS_URL=redis://localhost:6379

# Client Environment (Vite)
VITE_API_URL=/api/v1
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder_key

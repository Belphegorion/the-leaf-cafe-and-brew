# ═══════════════════════════════════════════════════════════════════════════
# THE LEAF – CAFE AND BREW | ENVIRONMENT CONFIGURATION (.env.example)
# STRICT RULE: All phone, WhatsApp, GSTIN, FSSAI are placeholders. Never fabricate them.
# ═══════════════════════════════════════════════════════════════════════════

# SERVER CONFIGURATION
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# DATABASE & CACHE
MONGODB_URI=mongodb://localhost:27017/the_leaf_db
REDIS_URL=redis://localhost:6379

# AUTHENTICATION
JWT_SECRET=replace_with_a_secure_jwt_secret_min_32_chars
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=replace_with_refresh_token_secret
REFRESH_TOKEN_EXPIRES_IN=30d

# PAYMENTS: RAZORPAY (Leave blank for automatic test mock simulation)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=placeholder_razorpay_webhook_secret

# COMMUNICATIONS & NOTIFICATIONS (Provider abstraction)
# WhatsApp Provider (MSG91 or Twilio)
WHATSAPP_PROVIDER=msg91
MSG91_AUTH_KEY=placeholder_msg91_auth_key
MSG91_WHATSAPP_TEMPLATE_ID=placeholder_template_id
TWILIO_ACCOUNT_SID=placeholder_twilio_sid
TWILIO_AUTH_TOKEN=placeholder_twilio_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Email Provider (Resend or Nodemailer)
RESEND_API_KEY=re_placeholder_resend_api_key
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=placeholder_smtp_pass
EMAIL_FROM=hello@theleaf.cafe

# OFFICIAL CAFE CONTACT & COMPLIANCE PLACEHOLDERS
# When actual verified numbers arrive from the cafe owners, inject them here:
VITE_CAFE_PHONE="+91 755 XXXXXXX (Config Placeholder)"
VITE_CAFE_WHATSAPP="+91 98930 XXXXX (Config Placeholder)"
VITE_CAFE_GSTIN="23AAAAA0000A1Z5 (PLACEHOLDER - Awaiting Cafe GSTIN Certificate)"
VITE_CAFE_FSSAI="10020000000000 (PLACEHOLDER - Awaiting Cafe FSSAI License No.)"
VITE_GOOGLE_MAPS_LINK="https://maps.google.com/?q=The+Leaf+Cafe+and+Brew+Arera+Colony+Bhopal"
